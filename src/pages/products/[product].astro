  },
};

const productData = data[product as keyof typeof data] as Generic;
---

<Layout
  title={`EvosHosting - ${productData.title} (${productData.long})`}
  description={`Get the best performance, support, and security for your ${productData.title} server with EvosHosting. Choose from a wide range of ${productData.title} hosting plans tailored to meet your specific needs.`}
>
  <div
    class="relative mb-20 flex flex-col items-center justify-between px-3 py-14 md:flex-row md:p-12"
  >
    <div
      class="text-gradient -z-40 hidden font-extrabold md:absolute md:block md:text-big-xl"
    >
      {productData.title.split(" ")[0]}
    </div>
    <div class="absolute left-4 top-0 z-10 md:flex md:w-1/4 md:justify-center">
      <div class="flex flex-col">
        <Image
          src={productData.images.left}
          alt="cloud"
          class="h-11 w-11 rotate-3 animate-fade-right md:h-28 md:w-28"
        />
        <Image
          src={productData.images.left}
          alt="cloud"
          class="ml-10 h-8 w-8 -rotate-3 animate-fade-right blur-xs md:ml-32 md:h-14 md:w-14 md:blur-0"
        />
      </div>
    </div>
    <div
      class="flex-col justify-center space-y-4 overflow-hidden md:order-2 md:flex md:w-full md:space-y-8"
    >
      <h1 class="text-center text-5xl font-extrabold md:text-7xl">
        {productData.title}
      </h1>

      <p
        class="text-balance text-center text-sm font-bold text-primary md:text-2xl"
      >
        {productData.long}
      </p>
    </div>
    <div
      class="absolute right-4 top-44 z-10 md:right-0 md:top-0 md:order-3 md:flex md:w-1/4 md:flex-col md:justify-center"
    >
      <Image
        src={productData.images.right}
        alt="cpu"
        class="ml-24 h-11 w-11 rotate-3 animate-fade-left md:h-28 md:w-28 md:blur-0"
      />
      <Image
        src={productData.images.right}
        alt="cpu"
        class="ml-10 h-8 w-8 -rotate-3 animate-fade-left shadow-primary blur-xs md:h-14 md:w-14 md:blur-0"
      />
    </div>
  </div>

  <div class="bg-pattern2">
    <div
      class="flex flex-col items-center justify-center space-y-5 md:flex-row md:space-x-5 md:space-y-0"
    >
      {
        productData.products.top.map((product: Product, i: number) => (
          <ShopCard
            {product}
            color={i === 1 ? "primary" : "secondary"}
            big={i === 1}
          />
        ))
      }
    </div>
    <div class="mt-20 space-y-6 px-8 pb-20 md:px-16">
      {
        productData.title !== "Discord Hosting" && (
          <>
            <div class="flex justify-between">
              <div>
                <h3 class="text-2xl font-bold text-primary">Want more?</h3>
                <h2 class="text-5xl font-extrabold text-white">All Plans</h2>
              </div>
            </div>
            <div class="grid grid-cols-1 gap-y-4 md:grid-cols-3 md:gap-x-8 xl:grid-cols-4 xl:grid-cols-center-4">
              {productData.products.full.map((product: Product) => (
                <ShopCard {product} color={"secondary"} />
              ))}
            </div>
          </>
        )
      }
      <div
        class="rounded-2xl border border-dark/50 p-5 text-center text-xl font-bold md:text-2xl"
      >
        <span class="text-primary">Delivery in 10min-1h</span>, subject to
        availability. <br />
        Contact us to request a custom plan.
      </div>
    </div>

    <div>
      <div class="text-center">
        <h3 class="text-2xl font-bold text-primary">{productData.vs.label}</h3>
        <h2 class="text-5xl font-extrabold text-white">
          What’s the Difference?
        </h2>
      </div>

      <div
        class="flex flex-col justify-between space-y-5 p-10 md:flex-row md:space-x-5 md:space-y-0"
      >
        {
          productData.vs.content.map((content: VsContent, i: number) => (
            <>
              {i === 1 && (
                <div class="flex flex-col items-center justify-center space-y-4">
                  <div class="h-1.5 w-full rounded-full bg-primary/20 md:h-64 md:w-1.5" />
                  <span class="text-2xl font-extrabold text-white/40">VS</span>
                  <div class="h-1.5 w-full rounded-full bg-primary/20 md:h-64 md:w-1.5" />
                </div>
              )}
              <div class="md:mx-auto md:max-w-[47%]">
                <div>
                  <h2 class="text-4xl font-extrabold">{content.title}</h2>
                  <div class="flex flex-col space-y-4">
                    <div class="flex items-center space-y-2">
                      <span class="mr-2 mt-2 text-lg font-bold">
                        PERFORMANCE
                      </span>
                      <div class="h-3 w-full rounded-full bg-primary/20">
                        <div
                          class="h-3 rounded-full bg-primary"
                          style={`width: ${content.perf.performance}%`}
                        />
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center space-y-2">
                    <span class="mr-2 mt-2 text-lg font-bold">
                      CUSTOMIZATION
                    </span>
                    <div class="h-3 w-full rounded-full bg-primary/20">
                      <div
                        class="h-3 rounded-full bg-primary"
                        style={`width: ${content.perf.customization}%`}
                      />
                    </div>
                  </div>
                  <div class="flex items-center space-y-2">
                    <span class="mr-2 mt-2 text-lg font-bold">PRICE</span>
                    <div class="h-3 w-full rounded-full bg-primary/20">
                      <div
                        class="h-3 rounded-full bg-primary"
                        style={`width: ${content.perf.price}%`}
                      />
                    </div>
                  </div>

                  <div class="pt-5">
                    {content.perf.text.map((text: TextItem) => (
                      <div class="space-y-2 py-1.5">
                        <h3 class="text-2xl font-extrabold">{text.title}</h3>
                        <p class="text-balance">{text.content}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </>
          ))
        }
      </div>
    </div>

    <div class="px-4 py-4">
      <Features client:load />
    </div>
  </div>
</Layout>

<style>
  .text-gradient {
    background-image: linear-gradient(to top, #011018 0%, #032e44 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
