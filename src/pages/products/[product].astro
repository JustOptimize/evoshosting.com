              },
            ],
          },
        },
      ],
    },
  },
  discord: {
    title: "Discord Hosting",
    long: "Discord Bot Hosting",
    images: {
      left: cpu,
      right: ok,
    },
    products: {
      top: productsPreview[4] as Products,
      full: products[4] as Products,
    },
    vs: {
      label: "VPS Servers and Discord Hosting",
      content: [
        {
          title: "Discord Hosting",
          perf: {
            performance: 40,
            customization: 10,
            price: 10,
            text: [
              {
                title: "Performance",
                content:
                  "Performance is generally sufficient for many bots, but it is typically inferior compared to a VPS due to resource limitations and shared usage with other users.",
              },
              {
                title: "Customization",
                content:
                  "Customization is limited to the bot's code, since most of the installation is managed by our panel, making it simpler but also more limited.",
              },
              {
                title: "Price",
                content:
                  "Shared hosting services for Discord Bots are typically affordable, with many offering free or low-cost plans. However, for advanced features or higher resource needs, you might need to opt for more expensive plans.",
              },
            ],
          },
        },
        {
          title: "VPS",
          perf: {
            performance: 50,
            customization: 40,
            price: 20,
            text: [
              {
                title: "Performance",
