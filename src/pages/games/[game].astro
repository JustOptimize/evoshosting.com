---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import ShopCard from "@components/ShopCard.svelte";
import Features from "@components/Features.svelte";
import dirt from "@images/games/assets/dirt.webp";
import diamond from "@images/games/assets/diamond.webp";
import money from "@images/games/assets/money.svg";
import wep from "@images/games/assets/wep.svg";
import {
  gameProductsPreview,
  gameProducts,
  type GenericGame,
  type Product,
  type Products,
} from "@utils/products";

const { game } = Astro.params;

export type Data = {
  [a: string]: GenericGame;
};

let data: Data = {
  minecraft: {
    title: "Minecraft",
    long: "Server Hosting",
    images: {
      left: dirt,
      right: diamond,
    },
    image_bg: "/images/bg-mc.svg",
    products: {
      top: gameProductsPreview[0] as Products,
      full: gameProducts[0] as Products,
    },
  },
  gta: {
    title: "Grand Theft Auto",
    long: "Server Hosting",
    images: {
      left: wep,
      right: money,
    },
    image_bg: "/images/bg-gta.svg",
    products: {
      top: gameProductsPreview[1] as Products,
      full: gameProducts[1] as Products,
    },
  },
};

const productData = data[game as keyof typeof data] as GenericGame;
---

<Layout
  title={`EvosHosting - Host your ${productData.title} server`}
  bgImage={productData.image_bg}
  description=`Get powerful and reliable ${productData.title} server hosting for all your gaming needs. Experience maximum performance, customization, and security with our ${productData.title} server solutions.`
>
  <div
    class="relative mb-20 flex flex-col items-center justify-between overflow-hidden px-3 py-14 md:flex-row md:p-12"
  >
    <div
      class="text-gradient -z-40 hidden font-extrabold md:absolute md:block md:text-big-xl"
    >
      {productData.title === "Grand Theft Auto" ? "GTA" : productData.title}
    </div>
    <div class="absolute left-4 top-0 z-10 md:flex md:w-1/4 md:justify-center">
      <div class="flex flex-col">
        <Image
          src={productData.images.left}
          alt="cloud"
          class="h-11 w-11 rotate-3 animate-fade-right md:h-28 md:w-28"
        />
        <Image
          src={productData.images.left}
          alt="cloud"
          class="ml-10 h-8 w-8 -rotate-3 animate-fade-right blur-xs md:ml-32 md:h-14 md:w-14 md:blur-0"
        />
      </div>
    </div>
    <div
      class="flex-col justify-center space-y-4 overflow-hidden md:order-2 md:flex md:w-full md:space-y-8"
    >
      <h1 class="text-center text-7xl font-extrabold md:text-6xl">
        {productData.title}
      </h1>

      <p
        class="text-balance text-center text-sm font-bold text-primary md:text-2xl"
      >
        {productData.long}
      </p>
    </div>
    <div
      class="absolute right-4 top-44 z-10 md:right-0 md:top-0 md:order-3 md:flex md:w-1/4 md:flex-col md:justify-center"
    >
      <Image
        src={productData.images.right}
        alt="cpu"
        class="ml-24 h-11 w-11 rotate-3 animate-fade-left md:h-28 md:w-28 md:blur-0"
      />
      <Image
        src={productData.images.right}
        alt="cpu"
        class="ml-10 h-8 w-8 -rotate-3 animate-fade-left shadow-primary blur-xs md:h-14 md:w-14 md:blur-0"
      />
    </div>
  </div>

  <div
    class="flex flex-col items-center justify-center space-y-5 md:flex-row md:space-x-5 md:space-y-0"
  >
    {
      productData.products.top.map((product: Product, i: number) => (
        <ShopCard
          {product}
          color={
            i === 1 ? (game === "minecraft" ? "green" : "orange") : "secondary"
          }
          big={i === 1}
        />
      ))
    }
  </div>

  <div class="mt-20 space-y-6 px-8 pb-20 md:px-16">
    {
      productData.title !== "Discord" && (
        <>
          <div class="flex justify-between">
            <div>
              <h3 class="text-2xl font-bold text-primary">Want more?</h3>
              <h2 class="text-5xl font-extrabold text-white">All Plans</h2>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-x-8 gap-y-4 md:grid-cols-3 xl:grid-cols-4 xl:grid-cols-center-4">
            {productData.products.full.map((product: Product) => (
              <ShopCard
                {product}
                color={game === "minecraft" ? "green" : "orange"}
              />
            ))}
          </div>
        </>
      )
    }
    <div
      class="rounded-2xl border border-dark/50 p-5 text-center text-xl font-bold md:text-2xl"
    >
      <span class="text-primary">Delivery in 10min-1h</span>, subject to
      availability. <br />
      Contact us to request a custom plan.
    </div>
  </div>

  <div>
    <div class="px-4 py-4">
      <Features client:load />
    </div>
  </div>

  <style>
    .text-gradient {
      background-image: linear-gradient(
        to top,
        transparent 20%,
        #ffffff3d 100%
      );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  </style>
</Layout>
